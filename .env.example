# PUBLIC CLIENT CONFIG - não são segredos.
#
# Estes valores identificam o app Firebase Web publicamente e por design acompanham o bundle
# entregue ao navegador (o Firebase os expõe no HTML/JS de qualquer app que os use). A proteção
# real dos dados vem das Firestore Security Rules (owner-only) e do App Check, nunca de esconder
# estes valores. Ver docs/SECURITY.md.
#
# Preencha com os valores do Console Firebase > Configurações do projeto > Seus apps > Web app,
# projeto xtrainer-45f8d. Sem este arquivo preenchido como .env.local, o app usa o fallback
# público já embutido em src/lib/firebase.ts (mesmo projeto).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# App Check (Fase 25) - site key pública do reCAPTCHA Enterprise, também PUBLIC CLIENT CONFIG.
# Deixe vazio para manter o App Check desabilitado neste ambiente.
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=
