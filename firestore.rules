rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/system/config)
        && get(/databases/$(database)/documents/system/config).data.adminUid == request.auth.uid;
    }

    function ownsExisting() {
      return signedIn() && resource.data.ownerId == request.auth.uid;
    }

    function createsForSelf() {
      return signedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    function preservesOwner() {
      return request.resource.data.ownerId == resource.data.ownerId;
    }

    function validUser(data, uid) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role'])
        && data.keys().hasOnly(['uid', 'name', 'email', 'role', 'birthDate', 'height', 'sex', 'goal', 'photoURL', 'createdAt', 'updatedAt'])
        && data.uid == uid
        && data.uid is string
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 255
        && data.role in ['user', 'admin']
        && (!('birthDate' in data) || data.birthDate is string)
        && (!('height' in data) || data.height is number)
        && (!('sex' in data) || (data.sex is string && data.sex.size() <= 20))
        && (!('goal' in data) || (data.goal is string && data.goal.size() <= 200))
        && (!('photoURL' in data) || data.photoURL is string)
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function validExercise(data) {
      return data.keys().hasAll(['name', 'muscleGroup', 'active'])
        && data.keys().hasOnly(['id', 'name', 'nameEn', 'aliases', 'muscleGroup', 'muscleSubgroup', 'equipment', 'videoUrl', 'sortOrder', 'description', 'instructions', 'notes', 'active', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.muscleGroup is string && data.muscleGroup.size() >= 1 && data.muscleGroup.size() <= 60
        && data.active is bool
        && (!('id' in data) || data.id is string)
        && (!('nameEn' in data) || (data.nameEn is string && data.nameEn.size() <= 120))
        && (!('aliases' in data) || (data.aliases is list && data.aliases.size() <= 20))
        && (!('videoUrl' in data) || (data.videoUrl is string && data.videoUrl.matches('^https://(www[.])?(youtube[.]com|youtu[.]be)/.*')))
        && (!('description' in data) || (data.description is string && data.description.size() <= 2000))
        && (!('instructions' in data) || (data.instructions is string && data.instructions.size() <= 2000))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 4000))
        && (!('sortOrder' in data) || data.sortOrder is number);
    }

    function validMuscleGroup(data) {
      return data.keys().hasAll(['name', 'active'])
        && data.keys().hasOnly(['name', 'sortOrder', 'active', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 60
        && data.active is bool
        && (!('sortOrder' in data) || data.sortOrder is number);
    }

    function validWorkout(data) {
      return data.keys().hasAll(['ownerId', 'name', 'title', 'muscleGroups', 'exercises', 'active'])
        && data.keys().hasOnly(['id', 'ownerId', 'name', 'title', 'description', 'muscleGroups', 'exercises', 'exerciseGroups', 'active', 'createdAt', 'updatedAt'])
        && data.ownerId is string
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && (!('description' in data) || (data.description is string && data.description.size() <= 2000))
        && data.muscleGroups is list && data.muscleGroups.size() <= 20
        && data.exercises is list && data.exercises.size() <= 60
        && (!('exerciseGroups' in data) || (data.exerciseGroups is list && data.exerciseGroups.size() <= 20))
        && data.active is bool;
    }

    function validSession(data) {
      return data.keys().hasAll(['ownerId', 'workoutId', 'workoutName', 'exercises', 'totalVolume', 'totalSets', 'status'])
        && data.keys().hasOnly(['ownerId', 'workoutId', 'workoutName', 'startedAt', 'endedAt', 'durationSeconds', 'restEndsAt', 'exercises', 'exerciseGroups', 'totalVolume', 'totalSets', 'status', 'notes'])
        && data.ownerId is string
        && data.workoutId is string
        && data.workoutName is string && data.workoutName.size() <= 120
        && data.exercises is list && data.exercises.size() <= 60
        && (!('exerciseGroups' in data) || (data.exerciseGroups is list && data.exerciseGroups.size() <= 20))
        && data.totalVolume is number
        && data.totalSets is number
        && data.status in ['active', 'completed', 'cancelled']
        && (!('startedAt' in data) || data.startedAt is timestamp)
        && (!('endedAt' in data) || data.endedAt is timestamp)
        && (!('durationSeconds' in data) || data.durationSeconds is number)
        && (!('restEndsAt' in data) || data.restEndsAt is timestamp)
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 4000));
    }

    function validSessionId(data, id) {
      return data.status != 'active' || id == 'active-' + request.auth.uid;
    }

    function validWeight(data) {
      return data.keys().hasAll(['ownerId', 'date', 'weight'])
        && data.keys().hasOnly(['ownerId', 'date', 'weight', 'note', 'source', 'assessmentId', 'createdAt', 'updatedAt'])
        && data.ownerId is string
        && data.date is string
        && data.weight is number
        && data.weight > 0
        && (!('note' in data) || (data.note is string && data.note.size() <= 500))
        && (!('source' in data) || data.source in ['manual', 'assessment'])
        && (!('assessmentId' in data) || data.assessmentId is string);
    }

    function validAssessment(data) {
      return data.keys().hasAll(['ownerId', 'date', 'type', 'measurements'])
        && data.keys().hasOnly(['ownerId', 'date', 'type', 'weight', 'height', 'bodyFat', 'fatMass', 'leanMass', 'measurements', 'skinfolds', 'assessmentProtocol', 'notes', 'photos', 'createdAt', 'updatedAt'])
        && data.ownerId is string
        && data.date is string
        && data.type in ['quick', 'complete', 'advanced']
        && data.measurements is map
        && (!('skinfolds' in data) || data.skinfolds is map)
        && (!('photos' in data) || data.photos is map)
        && (!('weight' in data) || (data.weight is number && data.weight > 0))
        && (!('height' in data) || (data.height is number && data.height > 0))
        && (!('bodyFat' in data) || data.bodyFat is number)
        && (!('fatMass' in data) || data.fatMass is number)
        && (!('leanMass' in data) || data.leanMass is number)
        && (!('assessmentProtocol' in data) || (data.assessmentProtocol is string && data.assessmentProtocol.size() <= 200))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 4000));
    }

    match /system/config {
      allow read: if true;
      // Provisionado somente pelo Console/Admin SDK. Não existe bootstrap público.
      allow create, update, delete: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'user'
        // E-mail do documento precisa nascer igual ao e-mail autenticado no momento do cadastro
        // (quando o provedor expõe essa claim no token); impede um cliente adulterado de gravar
        // um e-mail diferente do da conta Firebase Auth.
        && (!('email' in request.auth.token) || request.resource.data.email == request.auth.token.email)
        && validUser(request.resource.data, uid);
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        // E-mail não é editável pela tela de Perfil: qualquer alteração de e-mail deve passar
        // pelo fluxo dedicado do Firebase Auth (reautenticação + updateEmail + verificação),
        // nunca por uma escrita direta neste documento.
        && request.resource.data.email == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'birthDate', 'height', 'sex', 'goal', 'photoURL', 'updatedAt'])
        && validUser(request.resource.data, uid);
      allow delete: if false;
    }

    match /exercises/{id} {
      allow read: if signedIn();
      allow create, update: if isAdmin() && validExercise(request.resource.data);
      allow delete: if isAdmin();
    }

    match /muscleGroups/{id} {
      allow read: if signedIn();
      allow create, update: if isAdmin() && validMuscleGroup(request.resource.data);
      allow delete: if isAdmin();
    }

    match /trainingMethods/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /workouts/{id} {
      allow read: if ownsExisting();
      allow create: if createsForSelf() && validWorkout(request.resource.data);
      allow update: if ownsExisting() && preservesOwner() && validWorkout(request.resource.data);
      allow delete: if ownsExisting();
    }

    match /workoutSessions/{id} {
      allow get: if ownsExisting()
        || (signedIn() && id == 'active-' + request.auth.uid);
      allow list: if ownsExisting();
      allow create: if createsForSelf()
        && validSession(request.resource.data)
        && validSessionId(request.resource.data, id);
      allow update: if ownsExisting()
        && preservesOwner()
        && validSession(request.resource.data)
        && validSessionId(request.resource.data, id)
        && (request.resource.data.status == resource.data.status
          || (resource.data.status == 'active' && request.resource.data.status in ['completed', 'cancelled']));
      allow delete: if ownsExisting();
    }

    match /bodyWeights/{id} {
      allow read: if ownsExisting();
      allow create: if createsForSelf() && validWeight(request.resource.data);
      allow update: if ownsExisting() && preservesOwner() && validWeight(request.resource.data);
      allow delete: if ownsExisting();
    }

    match /physicalAssessments/{id} {
      allow read: if ownsExisting();
      allow create: if createsForSelf() && validAssessment(request.resource.data);
      allow update: if ownsExisting() && preservesOwner() && validAssessment(request.resource.data);
      allow delete: if ownsExisting();
    }

    function validExerciseSubstitutionPreference(data) {
      return data.keys().hasAll(['ownerId', 'exerciseId', 'alternativeExerciseIds'])
        && data.keys().hasOnly(['ownerId', 'exerciseId', 'alternativeExerciseIds', 'createdAt', 'updatedAt'])
        && data.ownerId is string
        && data.exerciseId is string
        && data.alternativeExerciseIds is list && data.alternativeExerciseIds.size() <= 20;
    }

    match /exerciseSubstitutionPreferences/{id} {
      allow read: if ownsExisting();
      allow create: if createsForSelf() && validExerciseSubstitutionPreference(request.resource.data);
      allow update: if ownsExisting() && preservesOwner() && validExerciseSubstitutionPreference(request.resource.data);
      allow delete: if ownsExisting();
    }

    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['adminUid', 'action', 'entityType', 'entityId', 'timestamp'])
        && request.resource.data.keys().hasOnly(['adminUid', 'action', 'entityType', 'entityId', 'summary', 'timestamp'])
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.action is string
        && request.resource.data.entityType is string
        && request.resource.data.entityId is string
        && request.resource.data.timestamp is timestamp
        && (!('summary' in request.resource.data)
          || (request.resource.data.summary is string && request.resource.data.summary.size() <= 500)
          || request.resource.data.summary == null);
      allow update, delete: if false;
    }
  }
}
